#include "game.h"
#include "gfx.h"
#include "player.h"
#include "skill.h"
#include "variables.h"

void player_updateHudSkillPalette(u32 playerIndex)
{
    bool32 canCast;
    PlayerHud *hud;

    canCast = skill_active_canCast(
        playerIndex,
        (PLAYER(playerIndex).optionFlags.p & PLAYER_OPTION_FLAG_QUICK_SKILL_SELECT)
            ? PLAYER(playerIndex).quickSelectActiveSkills[(s8)PLAYER(playerIndex).selectedActiveSkill.cycleSkillIndex]
            : (s8)PLAYER(playerIndex).selectedActiveSkill.cycleSkillIndex);

    if (playerIndex == ACTIVE_PLAYER_INDEX && !(g_GameFlags.p & GAME_FLAG_OVERLAY))
    {
        hud = &g_PlayerHuds[playerIndex];
        if (!canCast && !(hud->flags.p & PLAYERHUD_FLAG_UNSPENT_POINTS))
        {
            if (hud->flags.p & PLAYERHUD_FLAG_SKILL_PANEL_DISABLED)
                return;
            gfx_loadPalette(HudSkillPaletteDisabled, 1);
            hud->flags.p |= PLAYERHUD_FLAG_SKILL_PANEL_DISABLED;
        }
        else if (hud->flags.p & PLAYERHUD_FLAG_SKILL_PANEL_DISABLED)
        {
            gfx_loadPalette(HudSkillPaletteNormal, 1);
            hud->flags.p &= ~PLAYERHUD_FLAG_SKILL_PANEL_DISABLED;
        }
    }
}

