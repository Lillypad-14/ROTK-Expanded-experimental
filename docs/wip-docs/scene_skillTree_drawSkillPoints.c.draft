#include "font.h"
#include "gfx.h"
#include "player.h"
#include "scene/skillTree.h"
#include "text.h"
#include "variables.h"

#define SkillTreePointsBgAsset ((const void *)0x08baf53c)

void scene_skillTree_drawSkillPoints(u8 playerIndex)
{
    char text[16];

    gfx_loadBgAsset(2, SkillTreePointsBgAsset, 0x2ff, 6, 14, 11);
    font_setStyle(FONT_STYLE_21PX, 3, -1);
    gfx_fillBgRect(3, 14, 11, 5, 4, 0);
    font_drawString(221, 130, 94, text_formatInt(PLAYER(playerIndex).skillPoints, text), 1);
}
